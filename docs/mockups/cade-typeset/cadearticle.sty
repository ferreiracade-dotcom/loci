% Shared design for retypeset articles (after the Suárez / Nosferatu layout)
\NeedsTeXFormat{LaTeX2e}\ProvidesPackage{cadearticle}
\RequirePackage[paperwidth=6in,paperheight=9in,left=0.9in,right=0.9in,top=0.8in,bottom=0.9in,headsep=0.25in,footskip=0.45in]{geometry}
\RequirePackage{fontspec}
\setmainfont{EBGaramond}[Path=fonts/,Extension=.otf,UprightFont=*-Regular,ItalicFont=*-Italic,BoldFont=*-Bold,Ligatures=TeX,Numbers=Lining]
\newfontfamily\greekfont{EBGaramond-Regular.otf}[Path=fonts/,Script=Greek]
\RequirePackage{microtype}
\RequirePackage[english]{babel}
\RequirePackage{fancyhdr}
\RequirePackage[bottom,hang]{footmisc}
\setlength{\footnotemargin}{1em}
\RequirePackage{titlesec}
\RequirePackage{xcolor}\colorlet{BLACK}{black}
\RequirePackage{hyperref}\hypersetup{hidelinks}
\renewcommand{\normalsize}{\fontsize{11}{16}\selectfont}\normalsize
\setlength{\parindent}{1.5em}\setlength{\parskip}{0pt}
\renewcommand\footnotesize{\fontsize{9}{11.5}\selectfont}
\renewcommand{\footnoterule}{\vspace*{-3pt}\noindent\rule{1.2in}{0.4pt}\vspace*{2.6pt}}
\newcommand{\runninghead}[1]{\fancyhead[C]{\fontsize{9.5}{12}\selectfont\addfontfeatures{LetterSpace=6}#1}}
\pagestyle{fancy}\fancyhf{}\fancyfoot[C]{\small\thepage}\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{opening}{\fancyhf{}\fancyfoot[C]{\small\thepage}}
% original journal pagination
\newcommand{\pg}[1]{\ifvmode\leavevmode\else\unskip\ \fi{\color{black!75}\footnotesize[#1]}\ \ignorespaces}
% headings
\titleformat{\section}[block]{\centering\normalsize\bfseries\addfontfeatures{LetterSpace=3}}{}{0pt}{\MakeUppercase}
\titlespacing*{\section}{0pt}{10pt plus 3pt minus 2pt}{6pt}
\titleformat{\subsection}[block]{\centering\fontsize{10}{14}\selectfont\addfontfeatures{LetterSpace=4}}{}{0pt}{\MakeUppercase}
\titlespacing*{\subsection}{0pt}{8pt plus 2pt minus 1pt}{4pt}
\newenvironment{bquote}{\par\vspace{4pt}\begin{list}{}{\leftmargin=1.5em\rightmargin=1.5em}\item\relax\fontsize{10}{14}\selectfont}{\end{list}\vspace{2pt}}
% opening block: \opening{Title}{Author}{Source line}
\newcommand{\opening}[3]{\thispagestyle{opening}\vspace*{-0.2in}
 \begin{center}{\fontsize{13.5}{19}\selectfont\bfseries\MakeUppercase{#1}}\\[14pt]
 {\scshape\MakeLowercase{#2}}\\[10pt]{\footnotesize #3}\end{center}\vspace{16pt}}
\emergencystretch=2em\tolerance=2000\hyphenpenalty=50
